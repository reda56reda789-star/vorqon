# VORQON — .env.example
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية على الخادم فقط.
# لا تضع أي سر حقيقي هنا، ولا ترسل .env إلى git أبداً.
# Copy to .env and fill real values on the server only. No real secrets here.

# --- General ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DEFAULT_LANGUAGE=ar
DEFAULT_CURRENCY=EGP
SUPPORTED_LANGUAGES=ar,en
SUPPORTED_CURRENCIES=EGP,USD,SAR,AED

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vorqon:CHANGE_ME_STRONG_PASSWORD@localhost:5432/vorqon?schema=public
POSTGRES_USER=vorqon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vorqon

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
# ولّد سراً قوياً (32+ حرفاً): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Admin ---
# بريد مالك المتجر: يُرقّى تلقائياً إلى admin عند التسجيل وعند كل إقلاع للخادم.
# Store owner's email: promoted to admin automatically on register and on every boot.
ADMIN_EMAIL=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# S3 / object storage (اختياري في الإنتاج):
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments — غير مفعّلة حتى توفير المفاتيح (انظر docs/INTEGRATIONS.md) ---
# Payments — NOT activated until provider keys are supplied.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
# أمثلة لأسماء المتغيرات عند التفعيل (اتركها فارغة الآن):
# PAYMOB_API_KEY= / PAYMOB_SECRET= / STRIPE_SECRET_KEY= / FAWRY_MERCHANT_CODE=

# --- Shipping — غير مفعّلة حتى توفير المفاتيح ---
SHIPPING_PROVIDER=none
SHIPPING_PROVIDER_API_KEY=
SHIPPING_PROVIDER_SECRET=

# --- Email / Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@vorqon.example

# --- Exchange rates ---
EXCHANGE_RATE_PROVIDER=none
EXCHANGE_RATE_API_KEY=
