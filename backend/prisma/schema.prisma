// VORQON — Prisma schema (mirrors database/schema.sql)
// اللغة الافتراضية ar. i18n via name_ar / name_en on every translatable model.
// Currencies: EGP (default), USD, SAR, AED. No card data is stored anywhere.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  seller
  admin
  staff
}

enum OrderStatus {
  pending
  confirmed
  preparing
  shipped
  delivered
  cancelled
  refunded
  returned
}

enum ProductStatus {
  draft
  pending_review
  published
  rejected
  archived
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  phone         String?
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  role          UserRole @default(customer)
  language      String   @default("ar") // ar | en
  currency      String   @default("EGP")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  seller        Seller?
  addresses     Address[]
  orders        Order[]
  reviews       Review[]

  @@map("users")
}

model Seller {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  businessNameAr  String   @map("business_name_ar")
  businessNameEn  String?  @map("business_name_en")
  status          String   @default("pending")
  commissionRate  Decimal  @default(5.00) @map("commission_rate") @db.Decimal(5, 2)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store           Store?
  products        Product[]

  @@map("sellers")
}

model Store {
  id        String @id @default(uuid()) @db.Uuid
  sellerId  String @unique @map("seller_id") @db.Uuid
  slug      String @unique
  nameAr    String @map("name_ar")
  nameEn    String @map("name_en")
  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  slug        String     @unique
  nameAr      String     @map("name_ar")
  nameEn      String     @map("name_en")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@map("categories")
}

model Brand {
  id     String    @id @default(uuid()) @db.Uuid
  slug   String    @unique
  nameAr String    @map("name_ar")
  nameEn String    @map("name_en")
  products Product[]

  @@map("brands")
}

model Product {
  id           String         @id @default(uuid()) @db.Uuid
  sellerId     String         @map("seller_id") @db.Uuid
  storeId      String         @map("store_id") @db.Uuid
  categoryId   String         @map("category_id") @db.Uuid
  brandId      String?        @map("brand_id") @db.Uuid
  sku          String         @unique
  nameAr       String         @map("name_ar")
  nameEn       String         @map("name_en")
  slug         String         @unique
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("EGP")
  stockQuantity Int           @default(0) @map("stock_quantity")
  status       ProductStatus  @default(draft)
  seller       Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  brand        Brand?         @relation(fields: [brandId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  reviews      Review[]

  @@map("products")
}

model ProductVariant {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  sku            String  @unique
  colorAr        String? @map("color_ar")
  colorEn        String? @map("color_en")
  sizeValue      String? @map("size_value")
  stockQuantity  Int     @default(0) @map("stock_quantity")
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  isMain    Boolean @default(false) @map("is_main")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Address {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  label     String @default("home")
  fullName  String @map("full_name")
  phone     String
  country   String @default("EG")
  city      String
  street    String
  isDefault Boolean @default(false) @map("is_default")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  parentOrderId    String?     @map("parent_order_id") @db.Uuid
  orderNumber      String      @unique @map("order_number")
  userId           String      @map("user_id") @db.Uuid
  sellerId         String?     @map("seller_id") @db.Uuid
  status           OrderStatus @default(pending)
  currency         String      @default("EGP")
  exchangeRateUsed Decimal     @default(1) @map("exchange_rate_used") @db.Decimal(18, 6)
  subtotal         Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal    Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal         Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal    Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal       Decimal     @default(0) @map("grand_total") @db.Decimal(12, 2)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             User        @relation(fields: [userId], references: [id])
  parent           Order?      @relation("OrderSplit", fields: [parentOrderId], references: [id])
  children         Order[]     @relation("OrderSplit")
  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  sellerId       String  @map("seller_id") @db.Uuid
  nameAr         String  @map("name_ar")
  nameEn         String  @map("name_en")
  sku            String
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal @map("line_total") @db.Decimal(12, 2)
  commissionRate Decimal @default(5.00) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmt  Decimal @default(0) @map("commission_amt") @db.Decimal(12, 2)
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Review {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  rating    Int
  body      String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
