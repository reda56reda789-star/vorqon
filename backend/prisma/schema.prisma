// VORQON — Prisma schema (mirrors database/schema.sql)
// اللغة الافتراضية ar. i18n via name_ar / name_en on every translatable model.
// Currencies: EGP (default), USD, SAR, AED. No card data is stored anywhere.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums mirror database/schema.sql exactly. The Postgres types use
// snake_case names, so each Prisma enum is mapped to the existing DB
// type via @@map — without it Prisma would look for types named
// "UserRole" / "OrderStatus" / etc. and fail at runtime, and modelling
// these columns as String fails with P2032 because Postgres returns
// the enum type, not text.
enum UserRole {
  customer
  seller
  admin
  staff

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  pending_verification
  banned

  @@map("user_status")
}

enum SellerStatus {
  pending
  approved
  rejected
  suspended

  @@map("seller_status")
}

enum ProductStatus {
  draft
  pending_review
  published
  rejected
  archived

  @@map("product_status")
}

enum OrderStatus {
  pending
  confirmed
  preparing
  shipped
  delivered
  cancelled
  refunded
  returned

  @@map("order_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cash_on_delivery

  @@map("payment_status")
}

enum PayoutStatus {
  pending
  approved
  paid
  rejected

  @@map("payout_status")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  phone         String?
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  role          UserRole @default(customer)
  language      String   @default("ar") // ar | en
  currency      String   @default("EGP")
  emailVerified Boolean  @default(false) @map("email_verified")
  failedLogins  Int      @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  seller        Seller?
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  favourites    Favourite[]

  @@map("users")
}

model Seller {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  businessNameAr  String   @map("business_name_ar")
  businessNameEn  String?  @map("business_name_en")
  status          SellerStatus @default(pending)
  commissionRate  Decimal      @default(5.00) @map("commission_rate") @db.Decimal(5, 2)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store           Store?
  products        Product[]

  @@map("sellers")
}

model Store {
  id        String @id @default(uuid()) @db.Uuid
  sellerId  String @unique @map("seller_id") @db.Uuid
  slug      String @unique
  nameAr    String @map("name_ar")
  nameEn    String @map("name_en")
  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  slug        String     @unique
  nameAr      String     @map("name_ar")
  nameEn      String     @map("name_en")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@map("categories")
}

model Brand {
  id     String    @id @default(uuid()) @db.Uuid
  slug   String    @unique
  nameAr String    @map("name_ar")
  nameEn String    @map("name_en")
  products Product[]

  @@map("brands")
}

model Product {
  id           String         @id @default(uuid()) @db.Uuid
  sellerId     String         @map("seller_id") @db.Uuid
  storeId      String         @map("store_id") @db.Uuid
  categoryId   String         @map("category_id") @db.Uuid
  brandId      String?        @map("brand_id") @db.Uuid
  sku          String         @unique
  nameAr       String         @map("name_ar")
  nameEn       String         @map("name_en")
  slug         String         @unique
  descriptionAr String?       @map("description_ar")
  descriptionEn String?       @map("description_en")
  price        Decimal        @db.Decimal(12, 2)
  compareAtPrice Decimal?     @map("compare_at_price") @db.Decimal(12, 2)
  currency     String         @default("EGP")
  stockQuantity Int           @default(0) @map("stock_quantity")
  status       ProductStatus  @default(draft)
  ratingAvg    Decimal        @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int            @default(0) @map("rating_count")
  soldCount    Int            @default(0) @map("sold_count")
  viewCount    Int            @default(0) @map("view_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  seller       Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  brand        Brand?         @relation(fields: [brandId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  reviews      Review[]
  favourites   Favourite[]

  @@map("products")
}

model ProductVariant {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  sku            String  @unique
  colorAr        String? @map("color_ar")
  colorEn        String? @map("color_en")
  sizeValue      String? @map("size_value")
  stockQuantity  Int     @default(0) @map("stock_quantity")
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  isMain    Boolean @default(false) @map("is_main")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Address {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  label     String @default("home")
  fullName  String @map("full_name")
  phone     String
  country   String @default("EG")
  city      String
  area      String?
  street    String
  building  String?
  postalCode String? @map("postal_code")
  isDefault Boolean @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// Wishlist — the DB table is `favourites` (schema.sql, present since the
// first schema); the API surface calls it the wishlist. Composite PK
// (user_id, product_id) makes duplicate adds impossible at the DB level.
model Favourite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favourites")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  parentOrderId    String?     @map("parent_order_id") @db.Uuid
  orderNumber      String      @unique @map("order_number")
  userId           String?     @map("user_id") @db.Uuid
  guestName        String?     @map("guest_name")
  guestPhone       String?     @map("guest_phone")
  guestCity        String?     @map("guest_city")
  guestAddress     String?     @map("guest_address")
  sellerId         String?     @map("seller_id") @db.Uuid
  addressId        String?     @map("address_id") @db.Uuid
  status           OrderStatus @default(pending)
  paymentStatus    PaymentStatus @default(pending) @map("payment_status")
  paymentMethodCode String?    @map("payment_method_code")
  currency         String      @default("EGP")
  exchangeRateUsed Decimal     @default(1) @map("exchange_rate_used") @db.Decimal(18, 6)
  subtotal         Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal    Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal         Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal    Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal       Decimal     @default(0) @map("grand_total") @db.Decimal(12, 2)
  couponCode       String?     @map("coupon_code")
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             User?       @relation(fields: [userId], references: [id])
  parent           Order?      @relation("OrderSplit", fields: [parentOrderId], references: [id])
  children         Order[]     @relation("OrderSplit")
  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  sellerId       String  @map("seller_id") @db.Uuid
  nameAr         String  @map("name_ar")
  nameEn         String  @map("name_en")
  sku            String
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal @map("line_total") @db.Decimal(12, 2)
  commissionRate Decimal @default(5.00) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmt  Decimal @default(0) @map("commission_amt") @db.Decimal(12, 2)
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Review {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  rating    Int
  body      String?
  createdAt DateTime @default(now()) @map("created_at")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
